{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "preset": "ludus",
  "presets": {
    "ludus": {
      "extends": "openai",
      "agents": {
        "librarian": {
          "skills_add": ["*"],
          "mcps": ["ludus-mcp","librarian"]
     	},
	  	"explorer": {
          "model": "openai/gpt-5.6-luna-fast",
          "variant": "low",
          "skills": [],
          "mcps": ["default","librarian","ludus-mcp"]
        },
        "fixer": {
          "skills_add": ["*"]
        },
        "oracle": {
          "skills_add": ["*"]
        }
      }
    }
  }
}
