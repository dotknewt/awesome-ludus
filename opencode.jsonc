{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "default": {
        "type": "local",
        "command": ["docker", "mcp", "gateway", "run", "--profile", "default"],
        "disabled": false
      },
	  "hermes": {
        "type": "local",
        "command": [
          "ssh",
          "dotme@hermes",
          "/home/dotme/.local/bin/hermes",
          "mcp",
          "serve"
        ],
      "disabled": true
      },
      "ludus-mcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@badsectorlabs/ludus-mcp",
          "--url",
          "https://ludus:8080",
          "--api-key",
          "{file:~/.secrets/ludus-mcp-key}"
        ],
        "disabled": false
      }
    }
  }
}
