{
  "$schema": "https://opencode.ai/config.json",
  "worktree": {
    "directory": ".worktrees"
  },
  "mcp": {
    "servers": {
      "ludus-mcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@badsectorlabs/ludus-mcp",
          "--url",
          "https://ludus:8080",
          "--api-key",
          "{file:~/.secrets/ludus-mcp-key}"
        ],
        "disabled": false
      },
      "hermes": {
        "type": "local",
        "command": [
          "ssh",
          "dotme@hermes",
          "/home/dotme/.local/bin/hermes",
          "mcp",
          "serve"
        ],
      "disabled": true
      }
    }
  }
}
