{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "default": {
        "type": "local",
        "command": ["docker", "mcp", "gateway", "run", "--profile", "default"],
        "disabled": false
      },
      "ludus": {
        "type": "local",
        "command": ["docker", "mcp", "gateway", "run", "--profile", "ludus"],
        "disabled": false
      },
	  "hermes": {
        "type": "local",
        "command": [
          "ssh",
          "dotme@hermes",
          "/home/dotme/.local/bin/hermes",
          "mcp",
          "serve"
        ],
      "disabled": true
      }
    }
  }
}
