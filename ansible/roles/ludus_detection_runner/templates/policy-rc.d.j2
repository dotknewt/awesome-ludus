#!/bin/sh
# detection-engineering runner_package_transaction
if [ "$1" = "gitlab-runner" ]; then
  case "${2:-}" in
    start|restart|try-restart|force-reload) exit 101 ;;
  esac
fi
if [ -x {{ detection_runner_policy_transaction_dir }}/original-policy ]; then
  exec {{ detection_runner_policy_transaction_dir }}/original-policy "$@"
fi
exit 0
