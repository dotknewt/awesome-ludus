# Effective Omnibus producer setting; gitlab-detection.rb.j2 includes this file.
nginx['log_format'] = {% set format_fields = [] %}{% for field in detection_gitlab_log_contract.producer_safe_fields.access %}{% if field == 'time' %}{% set _ = format_fields.append('time=$time_iso8601') %}{% elif field == 'identity' %}{% set _ = format_fields.append('identity=$remote_addr') %}{% elif field == 'method' %}{% set _ = format_fields.append('method=$request_method') %}{% elif field == 'path' %}{% set _ = format_fields.append('path=$uri') %}{% elif field == 'status' %}{% set _ = format_fields.append('status=$status') %}{% endif %}{% endfor %}{{ format_fields | join(' ') | to_json }}
