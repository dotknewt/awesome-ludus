apiVersion: v1
kind: Namespace
metadata:
  name: otel-system
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: otel-collector
  namespace: otel-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ detection_cluster_name }}-otel
rules:
{% for resource, verbs in detection_otel_contract.required_rbac | dictsort %}
  - apiGroups: [""]
    resources: ["{{ resource }}"]
    verbs: {{ verbs | to_json }}
{% endfor %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ detection_cluster_name }}-otel
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ detection_cluster_name }}-otel
subjects:
  - kind: ServiceAccount
    name: otel-collector
    namespace: otel-system
