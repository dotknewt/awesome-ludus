mode: daemonset
serviceAccount:
  create: false
  name: otel-collector
extraVolumes:
  - name: audit
    hostPath: {path: /var/log/kubernetes/audit, type: Directory}
  - name: containers
    hostPath: {path: /var/log/containers, type: Directory}
  - name: pods
    hostPath: {path: /var/log/pods, type: Directory}
  - name: splunk-hec
    secret:
      secretName: splunk-hec
      defaultMode: 0400
extraVolumeMounts:
  - {name: audit, mountPath: /var/log/kubernetes/audit, readOnly: true}
  - {name: containers, mountPath: /var/log/containers, readOnly: true}
  - {name: pods, mountPath: /var/log/pods, readOnly: true}
  - {name: splunk-hec, mountPath: /var/run/secrets/detection/hec, readOnly: true}
config:
  receivers:
    filelog/audit:
      include: ["{{ detection_otel_contract.audit_path }}"]
      operators:
        - {id: audit_json, type: json_parser, parse_from: body, parse_to: body}
        - {id: drop_request_object, type: remove, field: body.requestObject}
        - {id: drop_response_object, type: remove, field: body.responseObject}
{% for input in detection_otel_contract.node_log_inputs %}
    filelog/node_{{ loop.index }}:
      include: ["{{ input }}"]
{% endfor %}
  processors:
    k8sattributes: {}
    resource/range:
      attributes:
        - {key: detection.range_id, value: "{{ range_id }}", action: upsert}
  exporters:
    splunk_hec/audit:
      endpoint: "{{ detection_splunk_hec_url }}"
      token: '${file:/var/run/secrets/detection/hec/token}'
      index: de_runtime
      sourcetype: kube:audit
{% for input in detection_otel_contract.node_log_inputs %}
    splunk_hec/node_{{ loop.index }}:
      endpoint: "{{ detection_splunk_hec_url }}"
      token: '${file:/var/run/secrets/detection/hec/token}'
      index: de_runtime
      sourcetype: {{ 'kube:container' if '/var/log/containers/' in input else 'kube:node' }}
{% endfor %}
  service:
    pipelines:
      logs/audit:
        receivers: [filelog/audit]
        processors: [k8sattributes, resource/range]
        exporters: [splunk_hec/audit]
{% for input in detection_otel_contract.node_log_inputs %}
      logs/node_{{ loop.index }}:
        receivers: [filelog/node_{{ loop.index }}]
        processors: [k8sattributes, resource/range]
        exporters: [splunk_hec/node_{{ loop.index }}]
{% endfor %}
